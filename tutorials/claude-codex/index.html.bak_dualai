  <!-- HowTo Schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "點樣喺 Claude Code 入面用 Codex 外掛審 code",
    "description": "用 OpenAI 官方外掛 codex-plugin-cc，令 Claude Code 負責寫、Codex 負責審。",
    "inLanguage": "zh-Hant",
    "tool": [
      { "@type": "HowToTool", "name": "Claude Code" },
      { "@type": "HowToTool", "name": "Node.js 18.18 或以上" },
      { "@type": "HowToTool", "name": "ChatGPT 帳號（Free 都得）或 OpenAI API key" },
      { "@type": "HowToTool", "name": "git 專案" }
    ],
    "step": [
      {
        "@type": "HowToStep",
        "position": 1,
        "name": "安裝外掛",
        "url": "https://inari-kira-isla.github.io/yamanakada/tutorials/claude-codex/#step-1",
        "text": "喺 Claude Code 逐行輸入：/plugin marketplace add openai/codex-plugin-cc，然後 /plugin install codex@openai-codex，最後 /reload-plugins。"
      },
      {
        "@type": "HowToStep",
        "position": 2,
        "name": "執行 /codex:setup 檢查接駁",
        "url": "https://inari-kira-isla.github.io/yamanakada/tutorials/claude-codex/#step-2",
        "text": "輸入 /codex:setup，檢查 Codex 有冇裝、有冇登入。未登入就輸入 !codex login。"
      },
      {
        "@type": "HowToStep",
        "position": 3,
        "name": "用 /codex:review 叫 Codex 審一次",
        "url": "https://inari-kira-isla.github.io/yamanakada/tutorials/claude-codex/#step-3",
        "text": "喺 git 專案入面輸入 /codex:review 審未 commit 嘅改動，或者 /codex:review --base main 審分支同 main 嘅差異。呢個指令唯讀，唔會改檔案。"
      },
      {
        "@type": "HowToStep",
        "position": 4,
        "name": "用 /codex:adversarial-review 叫 Codex 唱反調",
        "url": "https://inari-kira-isla.github.io/yamanakada/tutorials/claude-codex/#step-4",
        "text": "輸入 /codex:adversarial-review，可以喺後面加你想佢集中質疑嘅重點。呢個指令唯讀，唔會修 code。"
      },
      {
        "@type": "HowToStep",
        "position": 5,
        "name": "按需要開啟 review gate（注意額度）",
        "url": "https://inari-kira-isla.github.io/yamanakada/tutorials/claude-codex/#step-5",
        "text": "輸入 /codex:setup --enable-review-gate 開啟，/codex:setup --disable-review-gate 關閉。官方警告 review gate 可能形成長時間來回循環，好快食晒用量限額，只喺你打算全程監察時先開。"
      }
    ]
  }
  </script>

  <!-- FAQPage Schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "用 Codex 外掛要另外開一個 Codex 帳號嗎？", "acceptedAnswer": { "@type": "Answer", "text": "如果你部機已經登入咗 Codex，外掛即用。如果你淨係用 Claude Code、未用過 Codex，就要用 ChatGPT 帳號或者 API key 登入 Codex。ChatGPT 訂閱（包括 Free）都得。打 /codex:setup 檢查，未登入就打 !codex login。" } },
      { "@type": "Question", "name": "外掛會另外開一個 Codex 運行環境嗎？", "acceptedAnswer": { "@type": "Answer", "text": "唔會。外掛通過你本機嘅 Codex CLI 同 Codex app server 做嘢，用同一個安裝、同一個登入狀態、同一個 repo checkout 同本機環境。" } },
      { "@type": "Question", "name": "我已經有 Codex 設定或者 API key，外掛會用到嗎？", "acceptedAnswer": { "@type": "Answer", "text": "會。外掛用你本機 Codex CLI，所以你現有嘅登入方式同 config 照樣有效，包括 ~/.codex/config.toml 同專案層面嘅 .codex/config.toml（專案層設定要專案已被信任先會載入）。" } },
      { "@type": "Question", "name": "/codex:review 同 /codex:adversarial-review 有咩分別？", "acceptedAnswer": { "@type": "Answer", "text": "/codex:review 係一般唯讀審查，唔可以帶自訂重點。/codex:adversarial-review 可以喺後面加重點文字，專登質疑你揀嘅實作同設計取捨，例如 auth、資料遺失、rollback、race condition 呢類風險位。兩個都係唯讀，唔會改你嘅檔案。" } }
    ]
  }
  </script>

  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@300;400;500;700;900&display=swap" rel="stylesheet">
  <style>
    :root {
      /* 站點原有 */
      --accent: #6366f1;
      --bg: #fafafa;
      --text: #1e293b;
      --text-light: #64748b;
      --card-bg: #ffffff;
      --border: #e2e8f0;
      /* 短片色板 */
      --navy: #17243A;
      --navy-2: #22344f;
      --amber: #F2A33A;
      --amber-bg: #fff6e6;
      --cyan: #5FD0E0;
      --cyan-dark: #0b7285;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body { font-family: 'Noto Sans TC', system-ui, sans-serif; background: var(--bg); color: var(--text); line-height: 1.85; overflow-wrap: anywhere; }
    a { color: var(--cyan-dark); }
    a:hover { text-decoration: underline; }
    code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 0.9em; background: #eef2f6; color: var(--navy); padding: 1px 6px; border-radius: 4px; }

    /* Nav：同首頁一致 */
    nav { background: #fff; border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: 100; }
    nav .container { max-width: 1080px; margin: 0 auto; padding: 0 16px; display: flex; justify-content: space-between; align-items: center; height: 56px; }
    nav .logo { font-weight: 700; font-size: 1.1rem; color: var(--text); }
    nav .logo span { color: var(--accent); }
    nav .back { font-size: 0.9rem; color: var(--text-light); }

    /* Hero */
    .hero { background-color: var(--navy);
      background-image:
        linear-gradient(rgba(95,208,224,0.10) 1px, transparent 1px),
        linear-gradient(90deg, rgba(95,208,224,0.10) 1px, transparent 1px);
      background-size: 32px 32px; color: #fff; padding: 56px 16px 48px; border-bottom: 4px solid var(--amber); }
    .hero .inner { max-width: 760px; margin: 0 auto; }
    .kicker { display: inline-block; color: var(--cyan); border: 1px solid var(--cyan); border-radius: 4px; padding: 2px 10px; font-size: 0.8rem; letter-spacing: 0.08em; margin-bottom: 18px; }
    .hero h1 { font-size: 2rem; font-weight: 900; line-height: 1.35; margin-bottom: 18px; }
    .hero h1 em { font-style: normal; color: var(--amber); }
    .hero .lead { font-size: 1.1rem; color: #dbe6f3; margin-bottom: 20px; }
    .hero .byline { font-size: 0.85rem; color: #9fb3cc; }
    .hero .byline strong { color: #fff; font-weight: 500; }

    /* Layout */
    main { max-width: 760px; margin: 0 auto; padding: 0 16px 24px; }
    section { padding-top: 40px; }
    h2 { font-size: 1.45rem; font-weight: 700; line-height: 1.4; color: var(--navy); margin-bottom: 14px; }
    h3 { font-size: 1.05rem; margin: 22px 0 8px; color: var(--navy); }
    p { margin-bottom: 14px; }
    ul.plain { margin: 8px 0 16px 22px; }
    ul.plain li { margin-bottom: 8px; }

    /* 前提清單 */
    .checklist { list-style: none; background: var(--card-bg); border: 1px solid var(--border); border-radius: 12px; padding: 8px 18px; }
    .checklist li { position: relative; padding: 12px 0 12px 34px; border-bottom: 1px solid var(--border); }
    .checklist li:last-child { border-bottom: 0; }
    .checklist li::before { content: ''; position: absolute; left: 4px; top: 19px; width: 14px; height: 8px; border-left: 3px solid var(--cyan-dark); border-bottom: 3px solid var(--cyan-dark); transform: rotate(-45deg); }
    .checklist b { color: var(--navy); }

    /* 步驟 */
    .step-head { display: flex; align-items: flex-start; gap: 12px; margin-bottom: 14px; }
    .step-no { flex: 0 0 auto; width: 40px; height: 40px; border-radius: 50%; background: var(--navy); color: var(--amber); font-weight: 900; font-size: 1.2rem; display: flex; align-items: center; justify-content: center; border: 2px solid var(--cyan); margin-top: 2px; }
    .step-head h2 { margin: 0; }
    .step-head .sub { display: block; font-size: 0.9rem; font-weight: 400; color: var(--text-light); margin-top: 2px; }

    /* Code block */
    .code { position: relative; background: var(--navy); border-radius: 10px; margin: 14px 0 18px; border-left: 4px solid var(--cyan); }
    .code pre { margin: 0; padding: 14px 76px 14px 14px; white-space: pre-wrap; overflow-wrap: anywhere; word-break: break-word; }
    .code code { background: transparent; color: #e8f4fa; padding: 0; font-size: 0.88rem; line-height: 1.7; }
    .copy { position: absolute; top: 8px; right: 8px; background: transparent; color: var(--cyan); border: 1px solid var(--cyan); border-radius: 6px; font: inherit; font-size: 0.78rem; padding: 3px 10px; cursor: pointer; min-height: 30px; }
    .copy:hover { background: rgba(95,208,224,0.15); }
    .copy.done { color: var(--navy); background: var(--cyan); }

    /* 提示框 */
    .note { background: #eef6f8; border-left: 4px solid var(--cyan-dark); border-radius: 0 8px 8px 0; padding: 14px 16px; margin: 16px 0; }
    .note p:last-child { margin-bottom: 0; }
    .warn { background: var(--amber-bg); border: 2px solid var(--amber); border-radius: 12px; padding: 18px 18px 6px; margin: 18px 0; }
    .warn .tag { display: inline-block; background: var(--amber); color: var(--navy); font-weight: 900; font-size: 0.9rem; padding: 2px 12px; border-radius: 4px; margin-bottom: 10px; }
    .warn p { color: #4a3510; }
    .warn strong { color: #7a4a00; }

    /* 比喻 */
    .metaphor { background: var(--navy); color: #e8f0f8; border-radius: 12px; padding: 24px 20px; margin-top: 8px; }
    .metaphor h2 { color: var(--amber); }
    .metaphor strong { color: #fff; }
    .metaphor .truth { background: rgba(95,208,224,0.12); border: 1px solid var(--cyan); border-radius: 8px; padding: 12px 14px; margin-top: 16px; color: #fff; }
    .metaphor code { background: rgba(255,255,255,0.12); color: var(--cyan); }

    /* 進階 */
    .adv { background: var(--card-bg); border: 1px solid var(--border); border-radius: 12px; padding: 18px 18px 4px; margin: 14px 0; }
    .adv h3 { margin-top: 0; }

    /* FAQ */
    details { background: var(--card-bg); border: 1px solid var(--border); border-radius: 10px; margin-bottom: 10px; }
    details summary { cursor: pointer; font-weight: 700; color: var(--navy); padding: 14px 16px; }
    details[open] summary { border-bottom: 1px solid var(--border); }
    details .ans { padding: 14px 16px 2px; color: #334155; }

    /* 來源 */
    .source { background: var(--card-bg); border: 1px solid var(--border); border-radius: 12px; padding: 18px; margin-top: 8px; }
    .source li { margin-bottom: 8px; }
    .verified { margin-top: 16px; font-size: 0.9rem; color: var(--text-light); border-top: 1px dashed var(--border); padding-top: 14px; }

    /* Footer：同首頁一致 */
    footer { background: #1e293b; color: #94a3b8; padding: 40px 16px; text-align: center; margin-top: 48px; }
    footer h4 { color: #fff; font-size: 1.05rem; margin-bottom: 12px; }
    footer p { margin-bottom: 8px; font-size: 0.9rem; }
    footer a { color: #818cf8; }

    @media (min-width: 769px) {
      .hero { padding: 80px 24px 64px; }
      .hero h1 { font-size: 2.6rem; }
      main { padding: 0 24px 24px; }
      nav .container { padding: 0 24px; }
      .code code { font-size: 0.95rem; }
    }
  </style>
</head>
<body>

<nav>
  <div class="container">
    <a class="logo" href="../../">靈動智<span>境</span> AI</a>
    <a class="back" href="../../#articles">&larr; 返回文章列表</a>
  </div>
</nav>

<header class="hero">
  <div class="inner">
    <span class="kicker">雙AI 教學筆記</span>
    <h1>兩個 AI 唔使揀：<em>一個做，一個審</em></h1>
    <p class="lead">Claude Code 寫 code，Codex 負責審。OpenAI 官方出咗個外掛，喺 Claude Code 入面一行指令就叫到 Codex 開工。5 步裝好、用得。</p>
    <p class="byline">作者 <strong>Joe｜從事水產貿易嘅建築AI男</strong> · 核實日期 2026-11-15 · 約 6 分鐘讀完</p>
  </div>
</header>

<main>
  <article>

    <section id="prereq">
      <h2>開始前要有乜</h2>
      <ul class="checklist">
        <li><b>Claude Code</b>：呢個外掛係畀 Claude Code 用家做嘅，要先裝好。</li>
        <li><b>Node.js 18.18 或以上</b></li>
        <li><b>ChatGPT 帳號（Free 都得）或者 OpenAI API key</b></li>
        <li><b>你嘅專案要係 git repo</b>：Codex 審嘅係 repo 入面嘅改動，下面有講。</li>
        <li><b>用量計入你嘅 Codex 額度</b>：Codex 做幾多嘢，就食幾多你嘅 Codex 用量限額。</li>
      </ul>
    </section>

    <section id="step-1">
      <div class="step-head">
        <div class="step-no">1</div>
        <h2>安裝外掛<span class="sub">喺 Claude Code 入面打，3 行</span></h2>
      </div>
      <p>逐行貼入 Claude Code 嘅對話框，每行撳一次 Enter：</p>
      <div class="code">
        <button class="copy" type="button" aria-label="複製 3 行安裝指令">複製</button>
<pre><code>/plugin marketplace add openai/codex-plugin-cc
/plugin install codex@openai-codex
/reload-plugins</code></pre>
      </div>
      <p>第一行加入 OpenAI 官方外掛市集，第二行裝 Codex 外掛，第三行重新載入外掛。裝好之後，你會見到下面幾條 <code>/codex:</code> 開頭嘅指令，而 <code>/agents</code> 入面亦會多咗個 <code>codex:codex-rescue</code> subagent。</p>
    </section>

    <section id="step-2">
      <div class="step-head">
        <div class="step-no">2</div>
        <h2>檢查接駁<span class="sub"><code>/codex:setup</code></span></h2>
      </div>
      <div class="code">
        <button class="copy" type="button" aria-label="複製指令">複製</button>
<pre><code>/codex:setup</code></pre>
      </div>
      <p>佢會檢查你部機有冇裝 Codex、有冇登入。如果 Codex 未裝，而你有 npm，佢可以提出幫你裝。想自己裝，就用呢行：</p>
      <div class="code">
        <button class="copy" type="button" aria-label="複製指令">複製</button>
<pre><code>npm install -g @openai/codex</code></pre>
      </div>
      <p>Codex 裝咗但未登入，就喺 Claude Code 入面打（前面嗰個感嘆號要打）：</p>
      <div class="code">
        <button class="copy" type="button" aria-label="複製指令">複製</button>
<pre><code>!codex login</code></pre>
      </div>
      <div class="note">
        <p>要留意：<code>/codex:setup</code> 只係檢查同引導登入。真正把外掛裝入 Claude Code 嘅，係第 1 步嗰 3 行。</p>
      </div>
    </section>

    <section id="step-3">
      <div class="step-head">
        <div class="step-no">3</div>
        <h2>叫 Codex 審一次<span class="sub"><code>/codex:review</code></span></h2>
      </div>
      <p>Claude 寫完一輪，就打 <code>/codex:review</code>。Codex 會做一次標準 code review，質素同你直接喺 Codex 入面打 <code>/review</code> 一樣。你可以審兩樣嘢：</p>
      <ul class="plain">
        <li>你而家<strong>未 commit</strong> 嘅改動</li>
        <li>成條分支同 <code>main</code> 之類 base 分支嘅差異（加 <code>--base</code>）</li>
      </ul>
      <div class="code">
        <button class="copy" type="button" aria-label="複製指令">複製</button>
<pre><code>/codex:review
/codex:review --base main
/codex:review --background</code></pre>
      </div>
      <p>改動多個檔案嘅話，審查會需要啲時間，官方建議喺背景跑。加 <code>--background</code> 之後，用 <code>/codex:status</code> 睇進度，完成後用 <code>/codex:result</code> 睇結果：</p>
      <div class="code">
        <button class="copy" type="button" aria-label="複製指令">複製</button>
<pre><code>/codex:review --background
/codex:status
/codex:result</code></pre>
      </div>
      <p>呢個指令<strong>唯讀</strong>，唔會改你任何檔案。佢亦唔可以帶自訂重點，想叫 Codex 專登質疑某個位，用第 4 步。睇完 Codex 指出嘅問題，叫 Claude 去改就得。</p>
    </section>

    <section id="step-4">
      <div class="step-head">
        <div class="step-no">4</div>
        <h2>叫 Codex 專登唱反調<span class="sub"><code>/codex:adversarial-review</code></span></h2>
      </div>
      <p>普通 review 睇嘅係「呢段 code 啱唔啱」。<code>/codex:adversarial-review</code> 再行前一步：質疑你揀咗嘅做法，問你有冇更安全、更簡單嘅路。佢揀審查範圍嘅方式同 <code>/codex:review</code> 一樣，但可以喺後面加重點文字：</p>
      <div class="code">
        <button class="copy" type="button" aria-label="複製指令">複製</button>
<pre><code>/codex:adversarial-review
/codex:adversarial-review --base main challenge whether this was the right caching and retry design
/codex:adversarial-review --background look for race conditions and question the chosen approach</code></pre>
      </div>
      <p>幾時用：出貨前、或者大改動、架構決定之後。官方列出嘅重點位包括 auth、資料遺失、rollback、race condition、可靠性。同樣係<strong>唯讀</strong>，只提問題，唔會幫你修 code。</p>
    </section>

    <section id="step-5">
      <div class="step-head">
        <div class="step-no">5</div>
        <h2>Review gate<span class="sub">Claude 一做完，Codex 自動審（慎用）</span></h2>
      </div>
      <div class="code">
        <button class="copy" type="button" aria-label="複製指令">複製</button>
<pre><code>/codex:setup --enable-review-gate
/codex:setup --disable-review-gate</code></pre>
      </div>
      <p>第一行開，第二行閂。開咗之後，Claude 每次答完，外掛會用 Stop hook 叫 Codex 針對 Claude 嘅回覆做一次審查。如果審出問題，Claude 就停唔到，要先處理完。即係「唔過唔收工」。</p>
      <div class="warn" role="alert">
        <span class="tag">額度警告</span>
        <p><strong>Review gate 可能形成 Claude 同 Codex 長時間來回嘅循環，好快食晒你嘅用量限額。</strong>官方嘅講法係：只喺你打算全程睇住個 session 嗰陣先開。</p>
        <p>實際做法：平時用第 3、4 步手動審就夠。大工程、重要改動先開 review gate，做完即刻 <code>--disable-review-gate</code> 閂返。</p>
      </div>
    </section>

    <section id="advanced">
      <h2>進階：交嘢畀 Codex，或者成個對話搬過去</h2>
      <div class="adv">
        <h3><code>/codex:rescue</code>：將任務交畀 Codex 做</h3>
        <p>前面 Codex 一直係審嗰個。用 <code>/codex:rescue</code> 就可以反過來，由 Claude 派工、Codex 落手：查 bug、試修、接續上一個 Codex 任務，或者用較細嘅模型快手過一次。</p>
        <div class="code">
          <button class="copy" type="button" aria-label="複製指令">複製</button>
<pre><code>/codex:rescue investigate why the tests started failing
/codex:rescue fix the failing test with the smallest safe patch
/codex:rescue --resume apply the top fix from the last run
/codex:rescue --background investigate the regression</code></pre>
        </div>
        <p>支援 <code>--background</code>、<code>--wait</code>、<code>--resume</code>、<code>--fresh</code>。唔指定模型同 effort，Codex 用自己嘅預設。</p>
      </div>
      <div class="adv">
        <h3><code>/codex:transfer</code>：成個 Claude Code 對話搬去 Codex</h3>
        <p>喺 Claude Code 傾咗一大輪 debug 或者實作，想原封不動喺 Codex 繼續，就打：</p>
        <div class="code">
          <button class="copy" type="button" aria-label="複製指令">複製</button>
<pre><code>/codex:transfer</code></pre>
        </div>
        <p>外掛會由你而家嘅 Claude Code 對話開一個持續嘅 Codex thread，並印出一行 <code>codex resume &lt;session-id&gt;</code> 畀你，照呢行去 Codex 接住做。如果你 Codex 版本太舊、冇 session import 功能，要先升級。</p>
      </div>
      <p>其他管理背景任務嘅指令：<code>/codex:status</code>（睇進度）、<code>/codex:result</code>（睇結果）、<code>/codex:cancel</code>（取消）。</p>
    </section>

    <section id="metaphor">
      <div class="metaphor">
        <h2>建築AI男嘅講法：畫圖同審圖</h2>
        <p>建築師畫完圖，唔會自己審自己，會交結構工程師過一次。<strong>Claude Code 係畫圖嗰個，Codex 係審圖嗰個</strong>。兩個唔使揀邊個，一個畫、一個審，圖先過得關。</p>
        <p>第 3 步嘅 <code>/codex:review</code> 好似結構工程師核對尺寸、荷載。第 4 步嘅 <code>/codex:adversarial-review</code> 就係工程師問一句：「點解唔用另一種結構？」</p>
        <div class="truth">
          <p><strong>講清楚，呢個只係比喻。</strong>Codex 實際審嘅唔係設計圖，係你 git repo 入面嘅 <strong>code</strong>：未 commit 嘅改動，或者分支對比 base 嘅差異。純做設計、唔寫 code 嘅工作流，呢個外掛用唔到。</p>
        </div>
      </div>
    </section>

    <section id="faq">
      <h2>常見問題</h2>
      <details>
        <summary>要另外開一個 Codex 帳號嗎？</summary>
        <div class="ans">
          <p>如果你部機已經登入咗 Codex，外掛即用。如果你淨係用 Claude Code、未用過 Codex，就要用 ChatGPT 帳號（Free 都得）或者 API key 登入 Codex。打 <code>/codex:setup</code> 檢查，未登入就打 <code>!codex login</code>。</p>
        </div>
      </details>
      <details>
        <summary>外掛會另外開一個 Codex 運行環境嗎？</summary>
        <div class="ans">
          <p>唔會。外掛通過你本機嘅 Codex CLI 同 Codex app server 做嘢：同一個安裝、同一個登入狀態、同一個 repo checkout 同本機環境。</p>
        </div>
      </details>
      <details>
        <summary>我已經有 Codex 設定或者 API key，外掛用得到嗎？</summary>
        <div class="ans">
          <p>用得到。外掛用你本機 Codex CLI，所以你現有嘅登入方式同 config 照樣有效，包括 <code>~/.codex/config.toml</code>，以及專案裡面嘅 <code>.codex/config.toml</code>（專案層設定要專案已被 Codex 信任先會載入）。</p>
        </div>
      </details>
      <details>
        <summary><code>/codex:review</code> 同 <code>/codex:adversarial-review</code> 有咩分別？</summary>
        <div class="ans">
          <p><code>/codex:review</code> 係一般唯讀審查，唔可以帶自訂重點。<code>/codex:adversarial-review</code> 可以喺後面加重點文字，專登質疑你揀嘅實作同設計取捨。兩個都係唯讀，都唔會改你嘅檔案。</p>
        </div>
      </details>
    </section>

    <section id="sources">
      <h2>官方來源</h2>
      <div class="source">
